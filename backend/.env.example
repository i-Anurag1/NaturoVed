# Copy this file to .env and adjust as needed

# Server
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=sqlite:///./storage/app.db

# Model storage
IMAGE_MODEL_PATH=./storage/models/disease_model.keras
FIELD_MODEL_PATH=./storage/models/field_model.joblib
LABEL_MAP_PATH=./storage/models/label_map.json

# Experimental feature-level fusion model (v2, optional)
FEATURE_FUSION_MODEL_PATH=./storage/models/feature_fusion_model.keras
FEATURE_FUSION_PREPROCESSOR_PATH=./storage/models/feature_fusion_model_field_preprocessor.joblib

# Live weather integration (v2, optional — see app/services/weather.py)
# Uses Open-Meteo (https://open-meteo.com), which requires NO API key.
WEATHER_PROVIDER=open-meteo
ENABLE_LIVE_WEATHER=true

# Upload
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=8
